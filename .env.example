# Classroom demo logins. setup.ps1 -Start also updates existing data volumes.
# These fixed passwords are for local demonstrations only, not public hosting.
MYSQL_DATABASE=dean3_shop
MYSQL_USER=wpuser
# phpMyAdmin / WordPress database account
MYSQL_PASSWORD=wp123456
# These internal service passwords are generated locally by setup.ps1.
MYSQL_ROOT_PASSWORD=replace-with-a-random-64-character-hex-secret
MYSQL_EXPORTER_PASSWORD=replace-with-a-random-64-character-hex-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
WORDPRESS_ADMIN_USER=teacher
WORDPRESS_ADMIN_PASSWORD=teacher123
WORDPRESS_ADMIN_EMAIL=teacher@example.test
